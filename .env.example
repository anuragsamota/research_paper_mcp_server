# Copy to .env and adjust. All variables are optional.
RESEARCH_DATA_DIR=./data
# auto | hash | sentence-transformers | ollama
RESEARCH_EMBEDDER=ollama
# nomic-embed-text for Ollama; or e.g. BAAI/bge-small-en-v1.5 with sentence-transformers
RESEARCH_EMBEDDING_MODEL=nomic-embed-text
# Ollama server on your LAN (used for the LLM and, with RESEARCH_EMBEDDER=ollama, for embeddings)
RESEARCH_OLLAMA_URL=http://192.168.1.50:11434
# Chat model with tool-calling support, pulled on the Ollama host
RESEARCH_LLM_MODEL=llama3.1:8b
# Optional: a different Ollama host just for the LLM (e.g. a GPU box), defaults to RESEARCH_OLLAMA_URL
RESEARCH_LLM_URL=
RESEARCH_LLM_NUM_CTX=8192
# Extra folders ingest_pdf may read from (colon-separated on Linux/macOS, semicolon on Windows)
RESEARCH_ALLOWED_DIRS=
# Raises the Semantic Scholar rate limit (free key: https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=
# Required when serving over HTTP beyond localhost
RESEARCH_API_TOKEN=
